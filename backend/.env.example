# Copy this file to backend/.env and add the API keys you want to use.
# Blank values disable that provider. You may use only one provider.
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OLLAMA_BASE_URL=http://localhost:11434

FISH_SPEECH_API_URL=https://api.fish.audio/v1/tts
FISH_SPEECH_API_KEY=
FISH_SPEECH_MODEL=s2-pro

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
NOVA_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=openai/gpt-oss-20b
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
OLLAMA_MODEL=llama3.2:3b
MODEL_TIMEOUT_SECONDS=20
NOVA_MODEL_FALLBACK=true
NOVA_MODEL_MAX_TOKENS=2048
